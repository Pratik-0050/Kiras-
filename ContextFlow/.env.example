# ContextFlow -- Environment Variable Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env (Linux/macOS)
#   copy .env.example .env (Windows PowerShell / CMD)

# Required: Your OpenAI (or OpenAI-compatible) API key
OPENAI_API_KEY=your-api-key-here

# Optional: Model name to use for summarization (default: gpt-4o-mini)
# Examples:
#   OpenAI      : gpt-4o-mini, gpt-4o, gpt-3.5-turbo
#   Groq        : llama-3.3-70b-versatile, mixtral-8x7b-32768
#   Ollama      : llama3:8b, mistral, qwen2.5:7b
#   OpenRouter  : openai/gpt-4o-mini, anthropic/claude-3-haiku
OPENAI_MODEL=gpt-4o-mini

# Optional: Embedding model name for semantic retrieval (default: text-embedding-3-small)
# Examples:
#   OpenAI      : text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
#   Ollama      : nomic-embed-text, mxbai-embed-large
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Base URL for any OpenAI-compatible API endpoint (default: https://api.openai.com/v1)
# Examples:
#   OpenAI (default) : https://api.openai.com/v1
#   Groq             : https://api.groq.com/openai/v1
#   Local Ollama     : http://localhost:11434/v1
#   OpenRouter       : https://openrouter.ai/api/v1
#   Azure OpenAI     : https://<your-resource>.openai.azure.com/openai/deployments/<deployment-name>
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Request timeout in seconds for chat calls (default: 60.0)
OPENAI_TIMEOUT=60.0

# Optional: ChromaDB collection name for the Step 15 vector store (default: contextflow)
CHROMA_COLLECTION=contextflow

# Optional: Directory for ChromaDB on-disk persistence (unset = in-memory only)
# Example: ./chroma_data
CHROMA_PERSIST_DIR=
